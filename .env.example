# ==============================================================================
# SOBHA REALTY LUXURY CRM & PORTAL ENVIRONMENT CONFIGURATION
# IMPORTANT: Copy this file to '.env' and populate with your production secrets.
# NEVER commit the actual '.env' file to Git or version control!
# ==============================================================================

# Database Connection (MySQL / MariaDB / cPanel)
DB_HOST=localhost
DB_NAME=sobha_luxury_crm
DB_USER=cpanel_user
DB_PASS=YourSecureDatabasePasswordHere!
DB_CHARSET=utf8mb4

# Lead Notification Email Recipients (Comma-separated)
ADMIN_EMAILS=info@sobha-luxury.com,sales@sobha-luxury.com

# Optional Offline / Fallback Admin Access (Leave blank in production)
# When database is not reachable, this emergency fallback can authenticate if provided.
FALLBACK_ADMIN_USER=
FALLBACK_ADMIN_PASS=

# Security & Anti-Fraud Features
# Set to 1 to block submissions originating from VPN/Proxy connections
BLOCK_VPN=0

# Rate Limiting: Max submissions allowed from same IP within 1 hour
HOURLY_IP_RATE_LIMIT=5

# SMTP Email Configuration (If using SMTP relay instead of PHP mail())
SMTP_HOST=mail.sobha-luxury.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=enquiries@sobha-luxury.com
SMTP_PASS=YourSmtpEmailPasswordHere!
SMTP_FROM_NAME="Sobha Realty Luxury Desk"
